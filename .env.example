# 前端 API 基地址预留项；当前版本默认使用同源 /api，无需填写
VITE_API_BASE_URL=
# 平台 AI 的 OpenAI 兼容接口地址，例如 https://api.example.com/v1
AI_BASE_URL=
# 平台 AI 密钥；属于敏感信息，不要提交到代码仓库
AI_API_KEY=
# 平台 AI 模型 ID；可在 /baolongadmin 管理页获取并保存
AI_MODEL=
# /baolongadmin 管理页访问密码；建议使用至少 16 位随机密码，仅在部署环境设置，不要提交实际密码
BAOLONG_ADMIN_PASSWORD=
# 单次模型请求超时毫秒数
AI_TIMEOUT_MS=90000
# 模型接口类型：auto 自动探测并回退，或指定 responses/chat
AI_API_STYLE=auto
# API 服务监听端口
PORT=8787
# 上传图片的本地持久化目录
ASSET_DIR=./uploads
# 上传图片保留天数；实际最短保留 30 天
ASSET_TTL_DAYS=30
# 图片对外访问的 HTTPS 基地址；留空时使用当前站点
PUBLIC_BASE_URL=
# 读取公网图片时使用的 HTTP 代理，例如 http://127.0.0.1:10808；无需代理时留空
HTTPS_PROXY=
# 不使用代理的域名列表，逗号分隔；例如 localhost,example.com
NO_PROXY=
# 允许访问 API 的前端来源，多个来源用逗号分隔；生产环境填写网站域名
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# 每个来源每分钟最多创作/润色请求数
RATE_GENERATE_PER_MIN=10
# 每个来源每分钟最多文档解析请求数
RATE_PARSE_PER_MIN=20
# 每个来源每分钟最多图片上传请求数
RATE_ASSETS_PER_MIN=60
# 每个来源每分钟最多模型配置/模型列表查询请求数
RATE_CONFIG_PER_MIN=20
# 管理密码登录每个来源每分钟最多尝试次数
RATE_ADMIN_LOGIN_PER_MIN=8
# 生成、定制排版与 AI 修改共享的并发上限：单个来源 IP
GENERATION_CONCURRENCY_PER_SOURCE=2
# 生成、定制排版与 AI 修改共享的全站并发上限
GENERATION_CONCURRENCY_TOTAL=6
